// ============================================================================
// KMS Saigon Technology — Prisma schema
// 32 tables / 7 domains, mirroring doc/KMS_PLAN.md section 4.3
// Append-only tables enforced at application layer: AuditLog, AttendanceEvent,
// ArticleVersion (immutable snapshots).
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  // Thêm target Alpine (musl + OpenSSL 3) cho image Docker production
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Domain 1 — Identity & organization
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  passwordHash         String
  fullName             String
  orgUnitId            String?
  jobTitle             String?
  expertise            String[]   @default([])
  bio                  String?
  avatarUrl            String?
  faceConsentAt        DateTime?
  status               UserStatus @default(ACTIVE)
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  // --- Mở rộng HRMIS (Mục 4): hồ sơ nhân sự ---
  employeeCode         String?  @unique // mã nhân viên NV0001
  hireDate             DateTime?        // ngày vào làm việc
  employmentStatus     EmploymentStatus @default(PROBATION)
  baseSalary           Float?           // lương cơ bản theo tháng (VND)
  birthDate            DateTime?
  phone                String?
  address              String?

  orgUnit              OrgUnit?                    @relation("UserOrgUnit", fields: [orgUnitId], references: [id])
  roles                UserRole[]
  refreshTokens        RefreshToken[]
  authoredArticles     Article[]                   @relation("ArticleAuthor")
  articleVersions      ArticleVersion[]            @relation("VersionAuthor")
  attachments          Attachment[]                @relation("AttachmentUploader")
  reviews              ArticleReview[]             @relation("ReviewReviewer")
  comments             Comment[]                   @relation("CommentAuthor")
  reactions            Reaction[]
  views                ArticleView[]
  bookmarks            Bookmark[]
  spaceFollows         SpaceFollow[]
  spaceMemberships     SpaceMember[]
  createdSpaces        Space[]                     @relation("SpaceCreator")
  notifications        Notification[]
  audits               AuditLog[]                  @relation("AuditActor")
  onboardingAssignments OnboardingAssignment[]     @relation("AssignmentUser")
  createdPaths         OnboardingPath[]            @relation("PathCreator")
  handoverChecklists   HandoverChecklist[]         @relation("HandoverOwner")
  handoverItemsDone    HandoverItem[]              @relation("HandoverAssignee")
  settingsUpdated      Setting[]                   @relation("SettingUpdater")
  attendanceEvents     AttendanceEvent[]
  attendanceDays       AttendanceDay[]
  attendanceCorrections AttendanceCorrection[]    @relation("CorrectionBy")
  faceEmbeddings       FaceEmbedding[]
  managedDevices       AttendanceDevice[]          @relation("DeviceCreator")
  correctionsMade      AttendanceCorrection[]      @relation("CorrectionCorrector")

  // --- Quan hệ HRMIS ---
  contracts            Contract[]
  contractsCreated     Contract[]                  @relation("ContractCreator")
  certificates         Certificate[]
  leaveRequests        LeaveRequest[]
  leaveApproved        LeaveRequest[]              @relation("LeaveApprover")
  leaveBalances        LeaveBalance[]
  overtimeRequests     OvertimeRequest[]
  overtimeApproved     OvertimeRequest[]           @relation("OvertimeApprover")
  payslips             Payslip[]
  periodsLocked        PayrollPeriod[]             @relation("PeriodLocker")
  perfReviews          PerformanceReview[]         @relation("ReviewEmployee")
  perfReviewsGiven     PerformanceReview[]         @relation("ReviewReviewerHr")
  enrollments          TrainingEnrollment[]
  coursesCreated       TrainingCourse[]            @relation("CourseCreator")
  actionsOnMe          PersonnelAction[]           @relation("ActionSubject")
  actionsRequested     PersonnelAction[]           @relation("ActionRequester")
  actionsDecided       PersonnelAction[]           @relation("ActionDecider")
  requisitions         JobRequisition[]            @relation("RequisitionRequester")
  requisitionsDecided  JobRequisition[]            @relation("RequisitionDecider")
  documentsUploaded    HrDocument[]                @relation("DocumentUploader")
  comprehensiveProfile PersonnelComprehensiveProfile?

  @@index([orgUnitId])
  @@index([status])
  @@index([employmentStatus])
  @@map("users")
}

model Role {
  code        String     @id // ADMIN | KM_MANAGER | USER
  name        String
  description String?
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId   String
  roleCode String
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleCode], references: [code])

  @@id([userId, roleCode])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OrgUnit {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  parentId  String?
  path      String     @default("") // materialized "/rootId/childId/"
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent   OrgUnit?   @relation("OrgUnitTree", fields: [parentId], references: [id])
  children OrgUnit[]  @relation("OrgUnitTree")
  users    User[]     @relation("UserOrgUnit")
  spaces   Space[]
  onboardingPaths OnboardingPath[]

  @@index([parentId])
  @@map("org_units")
}

// ---------------------------------------------------------------------------
// Domain 2 — Spaces & content
// ---------------------------------------------------------------------------

enum SpaceVisibility {
  PUBLIC
  RESTRICTED
  PRIVATE
}

enum SpaceRole {
  MANAGER
  EDITOR
  CONTRIBUTOR
  VIEWER
}

model Space {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  description String?
  icon        String         @default("book-open")
  color       String         @default("#2563eb")
  parentId    String?
  orgUnitId   String?
  visibility  SpaceVisibility @default(PUBLIC)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  parent    Space?        @relation("SpaceTree", fields: [parentId], references: [id])
  subSpaces Space[]       @relation("SpaceTree")
  orgUnit   OrgUnit?      @relation(fields: [orgUnitId], references: [id])
  creator   User          @relation("SpaceCreator", fields: [createdBy], references: [id])
  members   SpaceMember[]
  articles  Article[]
  follows   SpaceFollow[]

  @@index([visibility])
  @@index([orgUnitId])
  @@map("spaces")
}

model SpaceMember {
  spaceId   String
  userId    String
  spaceRole SpaceRole @default(VIEWER)
  createdAt DateTime  @default(now())
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@map("space_members")
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  parentId String?
  parent   Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  articles Article[]

  @@map("categories")
}

model Tag {
  id       String        @id @default(uuid())
  name     String
  slug     String        @unique
  articles ArticleTag[]

  @@map("tags")
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

model Article {
  id               String        @id @default(uuid())
  spaceId          String
  categoryId       String?
  authorId         String
  title            String
  slug             String
  summary          String?
  status           ArticleStatus @default(DRAFT)
  currentVersionId String?       @unique
  publishedAt      DateTime?
  archivedAt       DateTime?
  reviewDueAt      DateTime?
  viewCount        Int           @default(0)
  helpfulCount     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  space          Space            @relation(fields: [spaceId], references: [id])
  category       Category?        @relation(fields: [categoryId], references: [id])
  author         User             @relation("ArticleAuthor", fields: [authorId], references: [id])
  versions       ArticleVersion[] @relation("ArticleVersions")
  currentVersion ArticleVersion?  @relation("ArticleCurrentVersion", fields: [currentVersionId], references: [id])
  tags           ArticleTag[]
  reviews        ArticleReview[]
  comments       Comment[]
  reactions      Reaction[]
  views          ArticleView[]
  bookmarks      Bookmark[]
  onboardingItems OnboardingPathItem[]
  handoverItems  HandoverItem[]

  @@unique([spaceId, slug])
  @@index([status, publishedAt])
  @@index([spaceId, status])
  @@index([authorId])
  @@map("articles")
}

model ArticleVersion {
  id         String   @id @default(uuid())
  articleId  String
  versionNo  Int
  title      String
  contentMd  String   @db.Text
  changeNote String?
  authorId   String
  createdAt  DateTime @default(now())

  article    Article  @relation("ArticleVersions", fields: [articleId], references: [id], onDelete: Cascade)
  author     User     @relation("VersionAuthor", fields: [authorId], references: [id])
  currentOf  Article? @relation("ArticleCurrentVersion")
  attachments Attachment[]

  @@unique([articleId, versionNo])
  @@map("article_versions")
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model Attachment {
  id               String   @id @default(uuid())
  articleVersionId String?
  uploaderId       String
  fileName         String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String?
  createdAt        DateTime @default(now())

  version ArticleVersion? @relation(fields: [articleVersionId], references: [id])
  uploader User           @relation("AttachmentUploader", fields: [uploaderId], references: [id])

  @@index([articleVersionId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Domain 3 — Publishing & review workflow
// ---------------------------------------------------------------------------

enum ReviewAction {
  SUBMIT
  APPROVE
  REQUEST_CHANGES
  REJECT
}

model ArticleReview {
  id         String       @id @default(uuid())
  articleId  String
  reviewerId String
  action     ReviewAction
  comment    String?
  createdAt  DateTime     @default(now())

  article  Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewReviewer", fields: [reviewerId], references: [id])

  @@index([articleId])
  @@index([reviewerId, action])
  @@map("article_reviews")
}

// ---------------------------------------------------------------------------
// Domain 4 — Interaction
// ---------------------------------------------------------------------------

model Comment {
  id         String    @id @default(uuid())
  articleId  String
  authorId   String
  parentId   String?
  body       String    @db.Text
  isQuestion Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User     @relation("CommentAuthor", fields: [authorId], references: [id])
  parent  Comment? @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([articleId])
  @@map("comments")
}

model Reaction {
  articleId String
  userId    String
  value     String  @default("HELPFUL")
  createdAt DateTime @default(now())
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@map("reactions")
}

model ArticleView {
  id        String   @id @default(uuid())
  articleId String
  userId    String?
  viewedAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([articleId, viewedAt])
  @@map("article_views")
}

model Bookmark {
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@map("bookmarks")
}

model SpaceFollow {
  userId    String
  spaceId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@map("space_follows")
}

// ---------------------------------------------------------------------------
// Domain 5 — Human lifecycle & knowledge lifecycle
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  IN_PROGRESS
  COMPLETED
}

model OnboardingPath {
  id            String   @id @default(uuid())
  title         String
  description   String?
  targetJobTitle String?
  orgUnitId     String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgUnit     OrgUnit?               @relation(fields: [orgUnitId], references: [id])
  creator     User                   @relation("PathCreator", fields: [createdBy], references: [id])
  items       OnboardingPathItem[]
  assignments OnboardingAssignment[]

  @@map("onboarding_paths")
}

model OnboardingPathItem {
  id         String  @id @default(uuid())
  pathId     String
  articleId  String
  sortOrder  Int     @default(0)
  isRequired Boolean @default(true)

  path       OnboardingPath          @relation(fields: [pathId], references: [id], onDelete: Cascade)
  article    Article                 @relation(fields: [articleId], references: [id])
  progress   OnboardingItemProgress[]

  @@index([pathId])
  @@map("onboarding_path_items")
}

model OnboardingAssignment {
  id        String           @id @default(uuid())
  pathId    String
  userId    String
  dueDate   DateTime?
  status    AssignmentStatus @default(IN_PROGRESS)
  assignedAt DateTime        @default(now())

  path     OnboardingPath            @relation(fields: [pathId], references: [id], onDelete: Cascade)
  user     User                      @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  progress OnboardingItemProgress[]

  @@unique([pathId, userId])
  @@map("onboarding_assignments")
}

model OnboardingItemProgress {
  assignmentId String
  itemId       String
  completedAt  DateTime @default(now())

  assignment OnboardingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  item       OnboardingPathItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([assignmentId, itemId])
  @@map("onboarding_item_progress")
}

enum HandoverStatus {
  OPEN
  CLOSED
}

enum ItemStatus {
  PENDING
  DONE
}

model HandoverChecklist {
  id          String         @id @default(uuid())
  ownerUserId String
  leavingDate DateTime
  status      HandoverStatus @default(OPEN)
  closedAt    DateTime?
  createdAt   DateTime       @default(now())

  owner User           @relation("HandoverOwner", fields: [ownerUserId], references: [id])
  items HandoverItem[]

  @@map("handover_checklists")
}

model HandoverItem {
  id          String     @id @default(uuid())
  checklistId String
  title       String
  articleId   String?
  assigneeId  String?
  status      ItemStatus @default(PENDING)
  completedAt DateTime?

  checklist HandoverChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  article   Article?          @relation(fields: [articleId], references: [id])
  assignee  User?             @relation("HandoverAssignee", fields: [assigneeId], references: [id])

  @@index([checklistId])
  @@map("handover_items")
}

// ---------------------------------------------------------------------------
// Domain 6 — System
// ---------------------------------------------------------------------------

enum NotificationType {
  REVIEW_REQUESTED
  REVIEW_RESULT
  COMMENT_ADDED
  ARTICLE_PUBLISHED
  ONBOARDING_ASSIGNED
  GENERIC
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(GENERIC)
  title     String
  body      String?
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  updater User? @relation("SettingUpdater", fields: [updatedBy], references: [id])

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Domain 7 — Attendance (multi-source: QR / face / machine / web)
// ---------------------------------------------------------------------------

enum DeviceType {
  QR_KIOSK
  MACHINE_WEBHOOK
  MACHINE_CSV
  SIMULATOR
}

model AttendanceDevice {
  id             String     @id @default(uuid())
  name           String
  type           DeviceType
  location       String?
  secretHash     String?
  status         String     @default("ACTIVE")
  lastSeenAt     DateTime?
  createdById    String
  createdAt      DateTime   @default(now())

  creator User             @relation("DeviceCreator", fields: [createdById], references: [id])
  events  AttendanceEvent[]

  @@map("attendance_devices")
}

model AttendanceEvent {
  id            String   @id @default(uuid())
  userId        String
  deviceId      String?
  source        String // QR | FACE | WEB | MACHINE | MANUAL
  occurredAt    DateTime
  payload       Json?
  anomalyReason String?
  createdAt     DateTime @default(now())

  device AttendanceDevice? @relation(fields: [deviceId], references: [id])
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("attendance_events")
}

enum DayStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  MISSING_PAIR
  ON_LEAVE
  HOLIDAY
}

model AttendanceDay {
  userId        String
  workDate      DateTime   @db.Date
  firstInAt     DateTime?
  lastOutAt     DateTime?
  workedMinutes Int        @default(0)
  lateMinutes   Int        @default(0)
  earlyMinutes  Int        @default(0)
  status        DayStatus  @default(PRESENT)
  eventCount    Int        @default(0)
  updatedAt     DateTime   @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, workDate])
  @@map("attendance_days")
}

model AttendanceCorrection {
  id          String   @id @default(uuid())
  userId      String
  workDate    DateTime @db.Date
  field       String
  oldValue    String?
  newValue    String?
  reason      String
  correctedBy String
  createdAt   DateTime @default(now())

  user        User @relation("CorrectionBy", fields: [userId], references: [id])
  correctedByUser User @relation("CorrectionCorrector", fields: [correctedBy], references: [id])

  @@index([userId, workDate])
  @@map("attendance_corrections")
}

model FaceEmbedding {
  id            String   @id @default(uuid())
  userId        String
  encryptedData String // base64(iv|tag|ciphertext) AES-256-GCM
  dimensions    Int      @default(128)
  source        String   @default("BROWSER")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("face_embeddings")
}

// ===========================================================================
// Domain 8 — HRMIS: hồ sơ nhân sự, chấm công – nghỉ phép – lương, tuyển dụng,
// đào tạo, đánh giá hiệu suất, biến động nhân sự, tài liệu (Mục 4 + Mục 8)
// ===========================================================================

enum EmploymentStatus {
  PROBATION // thử việc
  ACTIVE // chính thức
  RESIGNED // đã thôi việc
  RETIRED // nghỉ hưu
}

enum ContractType {
  PROBATION
  FIXED_TERM
  INDEFINITE
  INTERNSHIP
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

model Contract {
  id              String         @id @default(uuid())
  userId          String
  contractNo      String         @unique
  type            ContractType
  startDate       DateTime       @db.Date
  endDate         DateTime?      @db.Date
  baseSalary      Float
  insuranceSalary Float?
  status          ContractStatus @default(ACTIVE)
  note            String?
  fileUrl         String? // bản mềm hợp đồng (PDF/scan) upload lên /uploads
  fileName        String?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator User @relation("ContractCreator", fields: [createdById], references: [id])

  @@index([userId, status])
  @@map("contracts")
}

model Certificate {
  id          String    @id @default(uuid())
  userId      String
  name        String
  certNo      String? // số hiệu văn bằng
  issuedBy    String? // nơi cấp
  issuedDate  DateTime? @db.Date
  expiryDate  DateTime? @db.Date
  fileUrl     String? // bản quét
  storageSpot String? // vị trí tủ lưu trữ vật lý
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certificates")
}

enum LeaveType {
  ANNUAL // phép năm
  SICK // nghỉ ốm
  UNPAID // không lương
  MATERNITY // thai sản
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String        @id @default(uuid())
  userId       String
  type         LeaveType     @default(ANNUAL)
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  days         Float
  reason       String
  status       RequestStatus @default(PENDING)
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver User? @relation("LeaveApprover", fields: [approverId], references: [id])

  @@index([userId, status])
  @@index([status])
  @@map("leave_requests")
}

model LeaveBalance {
  userId    String
  year      Int
  entitled  Float @default(12) // phép năm luật định 12 ngày (+ thâm niên)
  used      Float @default(0) // trừ NGAY khi duyệt (UC20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, year])
  @@map("leave_balances")
}

model OvertimeRequest {
  id           String        @id @default(uuid())
  userId       String
  workDate     DateTime      @db.Date
  hours        Float
  reason       String
  status       RequestStatus @default(PENDING)
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver User? @relation("OvertimeApprover", fields: [approverId], references: [id])

  @@index([userId, status])
  @@index([status])
  @@map("overtime_requests")
}

enum PayrollStatus {
  OPEN
  CALCULATED
  REVIEWED
  LOCKED // khóa bất biến — mọi điều chỉnh qua kỳ sau
}

model PayrollPeriod {
  id           String        @id @default(uuid())
  month        Int
  year         Int
  status       PayrollStatus @default(OPEN)
  calculatedAt DateTime?
  lockedAt     DateTime?
  lockedById   String?
  note         String?
  createdAt    DateTime      @default(now())

  payslips Payslip[]
  locker   User?     @relation("PeriodLocker", fields: [lockedById], references: [id])

  @@unique([month, year])
  @@map("payroll_periods")
}

model Payslip {
  id            String  @id @default(uuid())
  periodId      String
  userId        String
  workingDays   Float   @default(0) // công hữu hiệu trong kỳ
  otHours       Float   @default(0) // giờ làm thêm ĐÃ DUYỆT
  baseSalary    Float   @default(0)
  otAmount      Float   @default(0) // hệ số 150% ngày thường (Điều 98 BLĐ)
  allowance     Float   @default(0) // phụ cấp cố định (ăn trưa, đi lại…)
  bonus         Float   @default(0)
  insurance     Float   @default(0) // BHXH 10,5% người lao động đóng
  incomeTax     Float   @default(0) // thuế TNCN lũy tiến giản lược
  otherDeduct   Float   @default(0)
  netSalary     Float   @default(0)
  note          String?
  createdAt     DateTime @default(now())

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([periodId, userId])
  @@index([userId])
  @@map("payslips")
}

enum RequisitionStatus {
  DRAFT
  PENDING_REVIEW // chờ thẩm định của HR
  APPROVED // đã duyệt — mở kế hoạch tuyển
  REJECTED
  CLOSED // đủ chỉ tiêu / hủy
}

model JobRequisition {
  id            String            @id @default(uuid())
  title         String
  position      String
  headcount     Int               @default(1)
  reason        String?
  status        RequisitionStatus @default(DRAFT)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  requester User        @relation("RequisitionRequester", fields: [requestedById], references: [id])
  decider   User?       @relation("RequisitionDecider", fields: [decidedById], references: [id])
  candidates Candidate[]

  @@index([status])
  @@map("job_requisitions")
}

enum CandidateStage {
  NEW // nhận hồ sơ
  SCREENING // sàng lọc
  INTERVIEW // phỏng vấn
  OFFER // thư mời
  HIRED // đã nhận việc
  REJECTED
}

model Candidate {
  id            String         @id @default(uuid())
  requisitionId String?
  fullName      String
  email         String?
  phone         String?
  source        String? // kênh: LinkedIn, VietnamWorks, giới thiệu nội bộ…
  stage         CandidateStage @default(NEW)
  rating        Int? // điểm phỏng vấn 1–5
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  requisition JobRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([requisitionId])
  @@map("candidates")
}

enum PerfReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED // nhân viên đã xác nhận đọc
}

model PerformanceReview {
  id           String          @id @default(uuid())
  userId       String // người được đánh giá
  reviewerId   String // người đánh giá (trưởng nhóm)
  period       String // ví dụ "2026-H1"
  score        Float? // điểm tổng 0–100
  strengths    String?
  improvements String?
  comment      String?
  status       PerfReviewStatus @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user     User @relation("ReviewEmployee", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewReviewerHr", fields: [reviewerId], references: [id])

  @@index([userId, period])
  @@index([reviewerId, status])
  @@map("performance_reviews")
}

enum CourseStatus {
  PLANNED
  ONGOING
  DONE
}

model TrainingCourse {
  id          String      @id @default(uuid())
  title       String
  description String?
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  capacity    Int?
  status      CourseStatus @default(PLANNED)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  creator     User                 @relation("CourseCreator", fields: [createdById], references: [id])
  enrollments TrainingEnrollment[]

  @@index([status])
  @@map("training_courses")
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

model TrainingEnrollment {
  courseId    String
  userId      String
  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
  @@map("training_enrollments")
}

// Đề xuất biến động nhân sự — dùng chung một bộ máy duyệt cho 5 loại
// (thuyên chuyển / điều chỉnh lương / khen thưởng / kỷ luật / thôi việc),
// đúng mẫu hình ApprovalEngine trong tài liệu thiết kế.
enum PersonnelActionType {
  TRANSFER // thuyên chuyển
  SALARY_ADJUST // điều chỉnh lương
  AWARD // khen thưởng
  DISCIPLINE // kỷ luật
  RESIGNATION // thôi việc
}

enum PersonnelActionStatus {
  PENDING
  APPROVED
  REJECTED
}

model PersonnelAction {
  id            String                @id @default(uuid())
  type          PersonnelActionType
  subjectId     String // nhân viên bị tác động
  requestedById String // người đề xuất
  decidedById   String?
  payload       Json // nội dung: {reason, effectiveDate, newOrgUnitId?, newSalary?, amount?…}
  status        PersonnelActionStatus @default(PENDING)
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime              @default(now())

  subject   User  @relation("ActionSubject", fields: [subjectId], references: [id])
  requester User  @relation("ActionRequester", fields: [requestedById], references: [id])
  decider   User? @relation("ActionDecider", fields: [decidedById], references: [id])

  @@index([status, type])
  @@index([subjectId])
  @@map("personnel_actions")
}

// Mục 8 — kho tài liệu quy trình nhân sự (chính sách, biểu mẫu, quyết định…)
enum DocumentCategory {
  POLICY // chính sách / quy định
  FORM // biểu mẫu
  DECISION // quyết định nhân sự
  PROCESS // quy trình nghiệp vụ
  REPORT // báo cáo
  OTHER
}

model HrDocument {
  id           String           @id @default(uuid())
  title        String
  category     DocumentCategory @default(OTHER)
  processArea  String? // tuyển dụng / hồ sơ / chấm công / lương…
  version      String           @default("1.0")
  description  String?
  contentMd    String?          @db.Text // nội dung dạng markdown (nếu có)
  fileUrl      String? // tập tin đính kèm (đã upload lên /uploads)
  fileName     String?
  fileSize     Int?
  tags         String[]         @default([])
  uploadedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  uploader User @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([category])
  @@map("hr_documents")
}

// ---------------------------------------------------------------------------
// Domain 9 — Quản trị Hồ sơ Nhân sự Toàn diện & Ngạch bậc Lương
// Áp dụng linh hoạt cho cả khối Doanh nghiệp Tư nhân lẫn Cơ quan, Đơn vị Sự nghiệp
// ---------------------------------------------------------------------------

model PersonnelRank {
  code         String   @id // Mã ngạch (ví dụ: "01.003", "01.002", "01.001", "06.031"...)
  name         String   // Tên ngạch (Chuyên viên cao cấp, Chuyên viên chính, Chuyên viên, Kỹ sư, Bác sĩ...)
  groupCode    String   // Phân loại nhóm ngạch: A3, A2, A1, B, C
  field        String?  // Lĩnh vực chuyên môn (Hành chính, Y tế, Giáo dục, Kỹ thuật...)
  totalSteps   Int      @default(9) // Số bậc tối đa trong ngạch (6 đến 16 bậc)
  stepMonths   Int      @default(36) // Thời gian giữ bậc nâng lương thường xuyên (24 hoặc 36 tháng)
  coefficients Json     // Mảng các hệ số lương từ bậc 1..N: [2.34, 2.67, 3.00, ...]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profiles        PersonnelComprehensiveProfile[]
  salaryHistories PersonnelSalaryHistory[]

  @@index([groupCode])
  @@map("personnel_ranks")
}

model PersonnelComprehensiveProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 1. Thông tin cá nhân & Lý lịch
  aliasName           String?   // Tên gọi khác
  gender              String?   // Nam / Nữ
  birthPlace          String?   // Nơi sinh
  hometown            String?   // Quê quán
  permanentAddress    String?   // Hộ khẩu thường trú
  currentAddress      String?   // Nơi ở hiện nay
  idCardNo            String?   // Số CMND / CCCD
  idCardIssueDate     DateTime? // Ngày cấp
  idCardIssuePlace    String?   // Nơi cấp
  ethnicity           String?   @default("Kinh") // Dân tộc
  religion            String?   @default("Không") // Tôn giáo
  familyOrigin        String?   // Thành phần gia đình xuất thân
  priorJob            String?   // Nghề nghiệp trước khi được tuyển dụng

  // 2. Tuyển dụng & Chức danh
  recruitDate         DateTime? // Ngày tuyển dụng
  recruitOrg          String?   // Cơ quan tuyển dụng
  currentOrgDate      DateTime? // Ngày vào cơ quan/đơn vị hiện tại
  officialDate        DateTime? // Ngày vào biên chế / chính thức
  govPosition         String?   // Chức vụ chính quyền / Chức danh quản lý
  mainDuty            String?   // Công việc chính đảm nhiệm

  // 3. Ngạch bậc, Tiền lương & Phụ cấp
  rankCode            String?
  rank                PersonnelRank? @relation(fields: [rankCode], references: [code])
  salaryStep          Int?      // Bậc lương hiện hưởng (1..16)
  salaryCoefficient   Float?    // Hệ số lương
  salaryStepDate      DateTime? // Ngày hưởng bậc lương
  overGradePercent    Float?    @default(0) // % Phụ cấp thâm niên vượt khung
  positionAllowance   Float?    @default(0) // Hệ số phụ cấp chức vụ
  otherAllowance      Float?    @default(0) // Hệ số phụ cấp khác
  socialInsuranceNo   String?   // Mã số BHXH
  socialInsuranceDate DateTime? // Ngày bắt đầu đóng BHXH

  // 4. Trình độ học vấn, chuyên môn & lý luận
  generalEducation    String?   @default("12/12") // Giáo dục phổ thông
  highestDegree       String?   // Học vị/Trình độ chuyên môn cao nhất
  majorCode           String?   // Mã ngành đào tạo
  majorName           String?   // Tên ngành đào tạo
  academicTitle       String?   // Học hàm (Giáo sư, Phó Giáo sư)
  academicTitleDate   DateTime? // Ngày phong học hàm
  politicalTheory     String?   // Lý luận chính trị (Cử nhân, Cao cấp, Trung cấp, Sơ cấp)
  stateManagement     String?   // Quản lý nhà nước (CVCC, CVC, Chuyên viên...)
  foreignLanguage     String?   // Ngoại ngữ chính
  informaticsLevel    String?   // Tin học
  ethnicLanguage      String?   // Tiếng dân tộc thiểu số

  // 5. Tổ chức Đoàn - Đảng - Quân ngũ
  unionJoinDate       DateTime? // Ngày vào Đoàn TNCS HCM
  partyJoinDate       DateTime? // Ngày vào Đảng CSVN (dự bị)
  partyOfficialDate   DateTime? // Ngày chính thức vào Đảng
  partyPosition       String?   // Chức vụ Đảng hiện giữ
  partyJoinPlace      String?   // Nơi kết nạp Đảng
  enlistmentDate      DateTime? // Ngày nhập ngũ
  dischargeDate       DateTime? // Ngày xuất ngũ
  militaryRank        String?   // Quân hàm / cấp bậc cao nhất
  honorTitle          String?   // Danh hiệu được phong tặng cao nhất

  // 6. Sức khỏe & Diện chính sách
  healthStatus        String?   @default("Tốt") // Tình trạng sức khỏe
  heightCm            Float?    // Chiều cao (cm)
  weightKg            Float?    // Cân nặng (kg)
  bloodType           String?   // Nhóm máu (A, B, AB, O)
  woundedClass        String?   // Hạng thương binh / bệnh binh
  policyFamily        String?   // Gia đình diện chính sách

  // 7. Sở trường & Lịch sử bản thân
  strengths           String?   // Sở trường công tác
  longestJob          String?   // Công việc làm lâu nhất
  historyNotes        Json?     // Ghi chú lịch sử bản thân (JSON)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // 8 Quá trình lịch sử con
  salaryHistories     PersonnelSalaryHistory[]
  appointments        PersonnelAppointment[]
  educations          PersonnelEducation[]
  workHistories       PersonnelWorkHistory[]
  rewardDisciplines   PersonnelRewardDiscipline[]
  familyRelations     PersonnelFamilyRelation[]
  appraisals          PersonnelAppraisal[]
  socialActivities    PersonnelSocialActivity[]

  @@index([rankCode])
  @@map("personnel_comprehensive_profiles")
}

model PersonnelSalaryHistory {
  id            String   @id @default(uuid())
  profileId     String
  profile       PersonnelComprehensiveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rankCode      String?
  rank          PersonnelRank? @relation(fields: [rankCode], references: [code])
  step          Int      // Bậc lương
  coefficient   Float    // Hệ số
  overGradeRate Float?   @default(0) // % Vượt khung
  fromDate      DateTime // Từ ngày
  toDate        DateTime? // Đến ngày
  decisionNo    String?  // Số quyết định
  decisionDate  DateTime? // Ngày ký quyết định
  signer        String?  // Người ký
  createdAt     DateTime @default(now())

  @@index([profileId])
  @@map("personnel_salary_histories")
}

model PersonnelAppointment {
  id             String    @id @default(uuid())
  profileId      String
  profile        PersonnelComprehensiveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  positionTitle  String    // Chức danh bổ nhiệm
  orgUnitName    String    // Đơn vị
  departmentName String?   // Phòng ban / Tổ
  effectiveDate  DateTime  // Ngày có hiệu lực
  expirationDate DateTime? // Ngày hết hiệu lực
  decisionNo     String?   // Số quyết định
  decisionDate   DateTime?
  signer         String?
  isCurrent      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([profileId])
  @@map("personnel_appointments")
}

model PersonnelEducation {
  id             String    @id @default(uuid())
  profileId      String
  profile        PersonnelComprehensiveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  schoolName     String    // Cơ sở đào tạo
  majorName      String    // Chuyên ngành
  degreeName     String    // Văn bằng / Chứng chỉ
  studyForm      String    @default("Chính quy") // Hình thức đào tạo
  fromDate       DateTime?
  toDate         DateTime?
  graduationYear Int?
  ranking        String?   // Xếp loại
  createdAt      DateTime  @default(now())

  @@index([profileId])
  @@map("personnel_educations")
}

model PersonnelWorkHistory {
  id             String    @id @default(uuid())
  profileId      String
  profile        PersonnelComprehensiveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fromDate       DateTime  // Từ tháng/năm
  toDate         DateTime? // Đến tháng/năm
  position       String    // Chức vụ / Công việc
  unitName       String    // Cơ quan / Đơn vị
  departmentName String?   // Bộ phận
  referencePerson String?  // Người xác nhận
  createdAt      DateTime  @default(now())

  @@index([profileId])
  @@map("personnel_work_histories")
}

enum RewardDisciplineType {
  REWARD
  DISCIPLINE
}

model PersonnelRewardDiscipline {
  id               String               @id @default(uuid())
  profileId        String
  profile          PersonnelComprehensiveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type             RewardDisciplineType
  title            String               // Tên hình thức khen thưởng / kỷ luật
  eventDate        DateTime             // Ngày quyết định / sự kiện
  decisionNo       String?              // Số quyết định
  issuingAuthority String?              // Cơ quan ký
  reason           String?              // Lý do
  createdAt        DateTime             @default(now())

  @@index([profileId, type])
  @@map("personnel_reward_disciplines")
}

enum FamilyCategory {
  SELF   // Gia đình bản thân (Bố, Mẹ, Vợ/Chồng, Con, Anh/Chị/Em ruột)
  SPOUSE // Gia đình bên Vợ / Chồng (Bố mẹ vợ/chồng...)
}

model PersonnelFamilyRelation {
  id           String         @id @default(uuid())
  profileId    String
  profile      PersonnelComprehensiveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category     FamilyCategory @default(SELF)
  relationType String         // Mối quan hệ: Bố, Mẹ, Vợ, Chồng, Con, Anh, Chị, Em
  fullName     String         // Họ và tên
  birthYear    Int?           // Năm sinh
  details      String?        // Quê quán, nghề nghiệp, nơi cư trú...
  createdAt    DateTime       @default(now())

  @@index([profileId, category])
  @@map("personnel_family_relations")
}

enum AppraisalClassification {
  EXCELLENT    // Hoàn thành xuất sắc nhiệm vụ
  GOOD         // Hoàn thành tốt nhiệm vụ
  SATISFACTORY // Hoàn thành nhiệm vụ
  UNSATISFACTORY // Không hoàn thành nhiệm vụ
}

model PersonnelAppraisal {
  id             String                  @id @default(uuid())
  profileId      String
  profile        PersonnelComprehensiveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year           Int                     // Năm đánh giá
  classification AppraisalClassification
  comment        String?                 // Nhận xét / Đánh giá
  decisionNo     String?                 // Quyết định công nhận
  createdAt      DateTime                @default(now())

  @@index([profileId, year])
  @@map("personnel_appraisals")
}

model PersonnelSocialActivity {
  id               String    @id @default(uuid())
  profileId        String
  profile          PersonnelComprehensiveProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fromDate         DateTime  // Từ ngày
  toDate           DateTime? // Đến ngày
  organizationName String    // Tên tổ chức chính trị - xã hội / đoàn thể
  positionTitle    String?   // Chức danh tham gia
  createdAt        DateTime  @default(now())

  @@index([profileId])
  @@map("personnel_social_activities")
}

// ============================================================================
// Domain 10 to 16: FRAPPE HRMS ENTERPRISE EXTENSIONS
// ============================================================================

// ---------------------------------------------------------------------------
// Domain 10: Shifts & Advanced Attendance Matrix
// ---------------------------------------------------------------------------

model HrmsShiftType {
  id                        String                @id @default(uuid())
  name                      String                // Ca hành chính, Ca sáng, Ca chiều, Ca đêm
  startTime                 String                // "08:00"
  endTime                   String                // "17:00"
  lateToleranceMinutes      Int                   @default(15)
  earlyExitToleranceMinutes Int                   @default(15)
  color                     String                @default("#3b82f6")
  enableAutoAttendance      Boolean               @default(true)
  description               String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  assignments               HrmsShiftAssignment[]

  @@map("hrms_shift_types")
}

enum ShiftAssignmentStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

model HrmsShiftAssignment {
  id          String                @id @default(uuid())
  userId      String
  shiftTypeId String
  startDate   DateTime
  endDate     DateTime?
  status      ShiftAssignmentStatus @default(ACTIVE)
  assignedBy  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  shiftType   HrmsShiftType         @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("hrms_shift_assignments")
}

// ---------------------------------------------------------------------------
// Domain 11: Dynamic Payroll & Salary Structure Engine
// ---------------------------------------------------------------------------

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

model HrmsSalaryComponent {
  id              String                    @id @default(uuid())
  code            String                    @unique // BASIC, LUNCH_ALLOW, POSITION_ALLOW, BHXH, PIT
  name            String                    // Lương cơ bản, Phụ cấp ăn trưa, Trừ BHXH...
  type            SalaryComponentType
  isTaxApplicable Boolean                   @default(true)
  isFormulaBased  Boolean                   @default(false)
  formula         String?                   // VD: "baseSalary * 0.08"
  defaultAmount   Float                     @default(0)
  description     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  structureItems  HrmsSalaryStructureItem[]

  @@map("hrms_salary_components")
}

model HrmsSalaryStructure {
  id               String                          @id @default(uuid())
  name             String                          // Cấu trúc lương Cán sự, Cấu trúc lương Quản lý...
  payrollFrequency String                          @default("MONTHLY")
  isActive         Boolean                         @default(true)
  description      String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  items            HrmsSalaryStructureItem[]
  assignments      HrmsSalaryStructureAssignment[]

  @@map("hrms_salary_structures")
}

model HrmsSalaryStructureItem {
  id          String              @id @default(uuid())
  structureId String
  componentId String
  amount      Float               @default(0)
  formula     String?
  createdAt   DateTime            @default(now())

  structure   HrmsSalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component   HrmsSalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([structureId])
  @@map("hrms_salary_structure_items")
}

model HrmsSalaryStructureAssignment {
  id          String              @id @default(uuid())
  userId      String
  structureId String
  fromDate    DateTime
  baseSalary  Float
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())

  structure   HrmsSalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("hrms_salary_structure_assignments")
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
  CANCELLED
}

model HrmsPayrollRun {
  id              String            @id @default(uuid())
  periodName      String            // Lương Tháng 08/2026
  fromDate        DateTime
  toDate          DateTime
  status          PayrollRunStatus  @default(DRAFT)
  totalEmployees  Int               @default(0)
  totalGrossPay   Float             @default(0)
  totalDeduction  Float             @default(0)
  totalNetPay     Float             @default(0)
  processedBy     String?
  processedAt     DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  slips           HrmsPayrollSlip[]

  @@map("hrms_payroll_runs")
}

model HrmsPayrollSlip {
  id             String          @id @default(uuid())
  payrollRunId   String
  userId         String
  employeeName   String
  employeeCode   String?
  department     String?
  jobTitle       String?
  workingDays    Float           @default(22)
  actualWorkDays Float           @default(22)
  baseSalary     Float           @default(0)
  grossPay       Float           @default(0)
  totalDeduction Float           @default(0)
  netPay         Float           @default(0)
  breakdown      Json            @default("{}") // Mảng chi tiết từng khoản cộng/trừ
  status         String          @default("DRAFT") // DRAFT, APPROVED, PAID
  createdAt      DateTime        @default(now())

  payrollRun     HrmsPayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([payrollRunId, userId])
  @@map("hrms_payroll_slips")
}

// ---------------------------------------------------------------------------
// Domain 12: Recruitment & ATS Candidate Pipeline
// ---------------------------------------------------------------------------

enum JobOpeningStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

model HrmsJobOpening {
  id            String             @id @default(uuid())
  title         String             // Tuyển dụng Kỹ sư Phần mềm Senior, Chuyên viên Nhân sự...
  department    String?
  designation   String?
  vacancies     Int                @default(1)
  minExperience Int                @default(1) // Năm kinh nghiệm
  salaryRange   String?            // VD: 15.000.000 - 25.000.000 VND
  description   String             @db.Text
  requirements  String?            @db.Text
  closingDate   DateTime?
  status        JobOpeningStatus   @default(OPEN)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  applicants    HrmsJobApplicant[]

  @@map("hrms_job_openings")
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW_ROUND_1
  INTERVIEW_ROUND_2
  OFFER_SENT
  HIRED
  REJECTED
}

model HrmsJobApplicant {
  id             String               @id @default(uuid())
  jobOpeningId   String
  candidateName  String
  email          String
  phone          String?
  stage          ApplicantStage       @default(APPLIED)
  rating         Int                  @default(0) // 1-5 sao
  resumeUrl      String?
  coverLetter    String?              @db.Text
  notes          String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  jobOpening     HrmsJobOpening       @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  interviews     HrmsInterviewRound[]
  offers         HrmsJobOffer[]

  @@index([jobOpeningId, stage])
  @@map("hrms_job_applicants")
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  HOLD
  REJECT
}

model HrmsInterviewRound {
  id              String                  @id @default(uuid())
  applicantId     String
  roundName       String                  // Phỏng vấn Kỹ thuật, Phỏng vấn Văn hóa
  interviewerName String                  // Người phỏng vấn
  scheduledAt     DateTime
  status          String                  @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  score           Float?                  // Thang điểm 100
  recommendation  InterviewRecommendation @default(HOLD)
  feedback        String?                 @db.Text
  createdAt       DateTime                @default(now())

  applicant       HrmsJobApplicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("hrms_interview_rounds")
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

model HrmsJobOffer {
  id            String           @id @default(uuid())
  applicantId   String
  offerDate     DateTime         @default(now())
  designation   String
  offeredSalary Float
  joiningDate   DateTime
  status        OfferStatus      @default(DRAFT)
  terms         String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  applicant     HrmsJobApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("hrms_job_offers")
}

// ---------------------------------------------------------------------------
// Domain 13: Employee Lifecycle Workflows
// ---------------------------------------------------------------------------

enum LifecycleEventType {
  ONBOARDING
  PROMOTION
  TRANSFER
  SEPARATION
  DISCIPLINARY
}

enum LifecycleEventStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  COMPLETED
}

model HrmsLifecycleEvent {
  id            String               @id @default(uuid())
  userId        String
  employeeName  String
  type          LifecycleEventType
  status        LifecycleEventStatus @default(PENDING)
  title         String               // Quyết định điều chuyển công tác, Tiếp nhận thử việc...
  decisionNo    String?
  effectiveDate DateTime
  details       Json                 @default("{}") // Chi tiết công việc bàn giao, phòng ban mới...
  notes         String?              @db.Text
  createdBy     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId, type])
  @@map("hrms_lifecycle_events")
}

model HrmsOnboardingTask {
  id          String   @id @default(uuid())
  title       String   // Cấp email & tài khoản, Bàn giao máy tính, Ký hợp đồng lao động...
  category    String   @default("IT") // IT, HR, ADMIN, DEPARTMENT
  assignee    String?
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  @@map("hrms_onboarding_tasks")
}

// ---------------------------------------------------------------------------
// Domain 14: Performance & 360 Appraisals
// ---------------------------------------------------------------------------

model HrmsAppraisalCycle {
  id          String               @id @default(uuid())
  name        String               // Đánh giá Hiệu suất Q3/2026, Đánh giá Thường niên 2026
  year        Int
  startDate   DateTime
  endDate     DateTime
  status      String               @default("ACTIVE") // PLANNED, ACTIVE, COMPLETED
  description String?
  createdAt   DateTime             @default(now())
  goals       HrmsAppraisalGoal[]
  reviews     HrmsAppraisalReview[]

  @@map("hrms_appraisal_cycles")
}

model HrmsAppraisalGoal {
  id            String             @id @default(uuid())
  cycleId       String
  userId        String
  employeeName  String
  kraTitle      String             // Vùng kết quả then chốt (KRA)
  description   String             @db.Text
  weightage     Float              @default(20) // Trọng số %
  targetMetric  String             // KPI mục tiêu: "Hoàn thành 100% sprint đúng hạn"
  selfScore     Float?             // Tự chấm (thang 100)
  managerScore  Float?             // Quản lý chấm
  finalScore    Float?
  status        String             @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  cycle         HrmsAppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, userId])
  @@map("hrms_appraisal_goals")
}

model HrmsAppraisalReview {
  id           String             @id @default(uuid())
  cycleId      String
  userId       String
  reviewerName String
  relationship String             @default("MANAGER") // SELF, MANAGER, PEER, SUBORDINATE
  rating       Float              @default(0) // 1-5 sao hoặc thang 100
  feedback     String             @db.Text
  submittedAt  DateTime           @default(now())

  cycle        HrmsAppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, userId])
  @@map("hrms_appraisal_reviews")
}

// ---------------------------------------------------------------------------
// Domain 15: Expense Claims & Travel Advances
// ---------------------------------------------------------------------------

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model HrmsTravelRequest {
  id              String              @id @default(uuid())
  userId          String
  employeeName    String
  purpose         String              // Công tác triển khai dự án chi nhánh Đà Nẵng
  fromLocation    String
  toLocation      String
  departureDate   DateTime
  returnDate      DateTime
  estimatedBudget Float               @default(0)
  status          ClaimStatus         @default(DRAFT)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  advances        HrmsEmployeeAdvance[]
  claims          HrmsExpenseClaim[]

  @@index([userId])
  @@map("hrms_travel_requests")
}

model HrmsEmployeeAdvance {
  id              String             @id @default(uuid())
  userId          String
  employeeName    String
  travelRequestId String?
  amount          Float
  purpose         String
  status          ClaimStatus        @default(DRAFT)
  disbursedAt     DateTime?
  createdAt       DateTime           @default(now())

  travelRequest   HrmsTravelRequest? @relation(fields: [travelRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("hrms_employee_advances")
}

model HrmsExpenseClaim {
  id              String             @id @default(uuid())
  userId          String
  employeeName    String
  travelRequestId String?
  title           String             // Thanh toán vé máy bay, hóa đơn tiếp khách...
  category        String             @default("TRAVEL") // TRAVEL, MEAL, LODGING, EQUIPMENT, OTHER
  totalAmount     Float
  approvedAmount  Float?
  status          ClaimStatus        @default(DRAFT)
  items           Json               @default("[]") // Chi tiết từng khoản chi
  receiptUrls     String[]           @default([])
  submittedAt     DateTime?
  approvedBy      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  travelRequest   HrmsTravelRequest? @relation(fields: [travelRequestId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("hrms_expense_claims")
}

// ---------------------------------------------------------------------------
// Domain 16: Training Programs & Grievance Handling
// ---------------------------------------------------------------------------

model HrmsTrainingProgram {
  id              String                 @id @default(uuid())
  name            String                 // Đào tạo Quy chuẩn Bảo mật, Nâng cao Nghiệp vụ Quản trị...
  trainerName     String
  location        String?
  startDate       DateTime
  endDate         DateTime
  maxParticipants Int                    @default(30)
  status          String                 @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  description     String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  feedbacks       HrmsTrainingFeedback[]

  @@map("hrms_training_programs")
}

model HrmsTrainingFeedback {
  id                String              @id @default(uuid())
  programId         String
  userId            String
  employeeName      String
  rating            Int                 @default(5) // 1-5 sao
  comments          String?             @db.Text
  certificateIssued Boolean             @default(false)
  createdAt         DateTime            @default(now())

  program           HrmsTrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("hrms_training_feedbacks")
}

enum GrievanceStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model HrmsGrievance {
  id           String          @id @default(uuid())
  userId       String
  employeeName String
  subject      String          // Kiến nghị về điều kiện làm việc / Môi trường công sở
  category     String          @default("WORK_ENVIRONMENT") // WORK_ENVIRONMENT, HARASSMENT, COMPENSATION, DISPUTE
  description  String          @db.Text
  status       GrievanceStatus @default(OPEN)
  resolution   String?         @db.Text
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, status])
  @@map("hrms_grievances")
}

// ---------------------------------------------------------------------------
// Domain 17: Employee Loan Management & Salary Deductions
// ---------------------------------------------------------------------------

model HrmsEmployeeLoan {
  id              String    @id @default(uuid())
  userId          String
  employeeName    String
  loanType        String    // Tạm ứng khẩn cấp, Vay mua thiết bị/nhà, Vay đào tạo
  principalAmount Float     // Số tiền vay gốc (VND)
  interestRate    Float     @default(0) // % Lãi suất hàng năm
  termMonths      Int       @default(12) // Thời hạn vay (tháng)
  monthlyEmi      Float     // Số tiền trả góp gốc + lãi mỗi tháng
  totalRepaid     Float     @default(0) // Số tiền đã hoàn trả
  remainingAmount Float     // Dư nợ còn lại
  status          String    @default("PENDING") // PENDING, APPROVED, DISBURSED, COMPLETED, REJECTED
  disbursedAt     DateTime?
  reason          String?   @db.Text
  approvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@map("hrms_employee_loans")
}

// ---------------------------------------------------------------------------
// Domain 18: Asset Custody & Allocation Management
// ---------------------------------------------------------------------------

model HrmsAssetAllocation {
  id                   String    @id @default(uuid())
  assetCode            String    @unique // AST-001, AST-002...
  name                 String    // MacBook Pro 16" M3 Max, Dell UltraSharp 27", Ghế Ergonomic...
  category             String    @default("IT_EQUIPMENT") // IT_EQUIPMENT, VEHICLE, FURNITURE, OFFICE_DEVICE
  serialNumber         String?
  assignedUserId       String?
  assignedEmployeeName String?
  allocatedDate        DateTime?
  returnedDate         DateTime?
  status               String    @default("AVAILABLE") // AVAILABLE, ALLOCATED, MAINTENANCE, DISPOSED
  condition            String    @default("EXCELLENT") // NEW, EXCELLENT, GOOD, DAMAGED
  value                Float     @default(0)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([assignedUserId, status])
  @@map("hrms_asset_allocations")
}

// ---------------------------------------------------------------------------
// Domain 19: Attendance Regularization & Shift Requests
// ---------------------------------------------------------------------------

model HrmsAttendanceRegularization {
  id                String    @id @default(uuid())
  userId            String
  employeeName      String
  workDate          DateTime  @db.Date
  requestedCheckIn  String?   // "08:30"
  requestedCheckOut String?   // "17:30"
  reason            String    @db.Text // Quên quẹt thẻ, Đi gặp khách hàng, Lỗi thiết bị kiosk
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy        String?
  decisionNote      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
  @@map("hrms_attendance_regularizations")
}

// ---------------------------------------------------------------------------
// Domain 8 — Master Catalogs (Hệ thống Danh mục chuẩn Nhà nước)
// ---------------------------------------------------------------------------

model MasterCatalogGroup {
  id          String               @id           // e.g. "personal_politics"
  title       String                              // "Nhân thân & Chính trị"
  description String               @db.Text
  sortOrder   Int                  @default(0)
  catalogs    MasterCatalog[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("master_catalog_groups")
}

model MasterCatalog {
  id       String               @id           // e.g. "dan_toc"
  name     String                              // "Danh mục Dân tộc"
  groupId  String
  group    MasterCatalogGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items    MasterCatalogItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([groupId])
  @@map("master_catalogs")
}

model MasterCatalogItem {
  id          String         @id @default(uuid())
  catalogId   String
  catalog     MasterCatalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  code        String                              // "KH" (Kinh)
  name        String                              // "Kinh"
  extra       Json?                               // { sector, maxStep, salarySteps, payTable, ... }
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([catalogId, code])
  @@index([catalogId])
  @@map("master_catalog_items")
}
