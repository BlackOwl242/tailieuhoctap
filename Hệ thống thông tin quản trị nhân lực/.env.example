# ============================================================================
# KMS Saigon Technology — Environment configuration
# Copy to `.env` to customize. The docker-compose stack also runs with NO .env
# file at all (safe demo defaults are baked in via ${VAR:-default}).
# ============================================================================

# --- Runtime -----------------------------------------------------------------
# "production" for the packaged demo; "development" enables hot-reload via
# docker-compose.override.yml
NODE_ENV=production

# Single user-facing port (Next.js web). Change only if 8080 is occupied.
WEB_PORT=8080
# API port exposed for Swagger (/api/docs). Can be closed by setting empty.
API_PORT=3001
# Host embedded into kiosk QR codes. For phone-on-LAN demos set your machine IP,
# e.g. http://192.168.1.20:8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Database (internal to the compose network) -------------------------------
POSTGRES_USER=kms
POSTGRES_PASSWORD=kms_demo_pw
POSTGRES_DB=kms
DATABASE_URL=postgresql://kms:kms_demo_pw@db:5432/kms?schema=public
# Uncomment to expose Postgres to the host for debugging (localhost only):
# DB_PORT_FORWARD=127.0.0.1:5433

# --- Security -----------------------------------------------------------------
# MUST be >= 32 chars. The default below is FOR DEMO ONLY — override in any
# real deployment (the API refuses to boot with a shorter/missing secret).
JWT_SECRET=change-me-in-real-deployment-32chars-min
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN_DAYS=7
CORS_ORIGIN=http://localhost:8080

# --- Uploads -------------------------------------------------------------------
UPLOAD_MAX_MB=10
# Container-internal path (mounted as the named volume kms_uploads)
UPLOAD_DIR=/app/uploads

# --- Observability --------------------------------------------------------------
LOG_LEVEL=info

# --- Seeding ---------------------------------------------------------------------
# Seed demo data exactly once when the database is empty
SEED_ON_FIRST_RUN=true
DEFAULT_ADMIN_EMAIL=admin@demo.local
DEFAULT_ADMIN_PASSWORD=Admin@123

# --- Attendance -------------------------------------------------------------------
# Kiosk QR rotation period (seconds); server accepts tokens up to 2x this TTL
QR_TOKEN_TTL_SEC=30
# Base64-encoded 32-byte key used to AES-256-GCM encrypt face embeddings
FACE_EMBEDDING_KEY=ZmFjZS1lbWJlZGRpbmcta2V5LTMyLWJ5dGVzLWJhc2U2NCEh
# Cosine similarity threshold for face match
FACE_MATCH_THRESHOLD=0.55
# Standard shift used to compute late/early minutes (overridable in Settings UI)
ATTENDANCE_WORK_START=08:00
ATTENDANCE_WORK_END=17:30

# --- Locale --------------------------------------------------------------------------
TZ=Asia/Ho_Chi_Minh
