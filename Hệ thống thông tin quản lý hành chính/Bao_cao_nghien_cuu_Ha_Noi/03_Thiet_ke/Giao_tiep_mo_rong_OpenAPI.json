  "components": {
    "schemas": {
      "Route": {
        "type": "object",
        "required": [
          "procedureVersionId",
          "systemId",
          "effectiveFrom",
          "legalBasis"
        ],
        "properties": {
          "procedureVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "systemId": {
            "type": "string",
            "format": "uuid"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "legalBasis": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ExternalEvent": {
        "type": "object",
        "required": [
          "sourceSystem",
          "eventId",
          "externalCaseId",
          "occurredAt",
          "sequence",
          "eventType",
          "payload"
        ],
        "properties": {
          "sourceSystem": {
            "type": "string"
          },
          "eventId": {
            "type": "string",
            "maxLength": 150
          },
          "externalCaseId": {
            "type": "string",
            "maxLength": 150
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "eventType": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "ACCEPTED",
              "ASSESSMENT",
              "ISSUED",
              "DELIVERED",
              "STOPPED"
            ]
          },
          "payload": {
            "type": "object",
            "description": "Dữ liệu theo hợp đồng được duyệt, không nhận trường tùy ý"
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "caseId",
          "recipientAgencyId",
          "scope",
          "mandatory",
          "dueAt",
          "version"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "recipientAgencyId": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "mandatory": {
            "type": "boolean"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ArchivePackage": {
        "type": "object",
        "required": [
          "packageId",
          "caseId",
          "manifestHash",
          "items"
        ],
        "properties": {
          "packageId": {
            "type": "string"
          },
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "manifestHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "documentId",
                "version",
                "sha256"
              ],
              "properties": {
                "documentId": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      },
      "Feedback": {
        "type": "object",
        "required": [
          "type",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SERVICE_FEEDBACK",
              "SATISFACTION",
              "OTHER_PROCESS"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "caseId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "id",
          "correlationId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Nhận thông điệp khác với áp dụng thành công nghiệp vụ"
          }
        }
      },
      "RouteList": {
        "type": "object",
        "required": [
          "asOf",
          "items"
        ],
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Route"
            }
          }
        }
      },
      "Reconciliation": {
        "type": "object",
        "required": [
          "asOf",
          "sourceSystem",
          "caseCount",
          "excludedDuplicates",
          "pendingEvents"
        ],
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "sourceSystem": {
            "type": "string"
          },
          "caseCount": {
            "type": "integer",
            "minimum": 0
          },
          "excludedDuplicates": {
            "type": "integer",
            "minimum": 0
          },
          "pendingEvents": {
            "type": "integer",
            "minimum": 0
          },
          "lastSourceAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "serviceAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Danh tính dịch vụ đã cấp riêng; kiểm tra TLS hai chiều và chữ ký thông điệp theo hợp đồng ở tầng tích hợp"
      }
    }
  }
}