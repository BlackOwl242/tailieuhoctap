{
  "openapi": "3.0.3",
  "info": {
    "title": "Giao tiếp mở rộng của thiết kế nghiên cứu",
    "version": "2.0.0",
    "description": "Không phải địa chỉ giao tiếp đang vận hành của Hà Nội. Cần thống nhất hợp đồng, nguồn trạng thái, xác thực thông điệp và chữ ký trước phát triển."
  },
  "paths": {
    "/v1/routes": {
      "get": {
        "operationId": "extended1",
        "summary": "Tra cứu tuyến tác nghiệp",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Kết quả tiếp nhận hoặc tra cứu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteList"
                }
              }
            }
          },
          "401": {
            "description": "Nguồn hoặc danh tính không hợp lệ"
          },
          "403": {
            "description": "Ngoài phạm vi quyền"
          },
          "409": {
            "description": "Xung đột phiên bản, tuyến hoặc thông điệp"
          },
          "422": {
            "description": "Không đủ điều kiện nghiệp vụ"
          }
        },
        "parameters": [
          {
            "name": "asOf",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "procedureVersionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "operationId": "extended7",
        "summary": "Đề nghị cấu hình tuyến",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Kết quả tiếp nhận hoặc tra cứu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "401": {
            "description": "Nguồn hoặc danh tính không hợp lệ"
          },
          "403": {
            "description": "Ngoài phạm vi quyền"
          },
          "409": {
            "description": "Xung đột phiên bản, tuyến hoặc thông điệp"
          },
          "422": {
            "description": "Không đủ điều kiện nghiệp vụ"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 150
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Route"
              }
            }
          }
        }
      }
    },
