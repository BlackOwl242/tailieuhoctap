          },
          "403": {
            "description": "Vai trò tài chính hoặc quản trị viên không được mở tệp thành phần hồ sơ cá nhân",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "Không tìm thấy tệp hoặc hồ sơ ngoài phạm vi cơ quan",
