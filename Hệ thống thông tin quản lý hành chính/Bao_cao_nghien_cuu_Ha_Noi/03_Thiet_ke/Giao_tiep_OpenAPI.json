    "/api/cases": {
      "post": {
        "operationId": "submitOnlineCase",
        "tags": ["CaseWorkflow"],
        "summary": "Nộp hồ sơ trực tuyến (sinh mã hồ sơ HN-YYYY-*, khóa tra cứu 64 hex mã hóa Fernet và trạng thái CHO_TIEP_NHAN)",
        "security": [
          { "citizenCookieAuth": [], "csrfTokenAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["procedureCode", "receivingAgency", "applicantType", "applicant", "submissionKey"],
                "properties": {
                  "procedureCode": { "type": "string" },
                  "receivingAgency": { "type": "string" },
                  "applicantType": { "type": "string", "enum": ["citizen", "organization"] },
                  "submissionKey": { "type": "string", "format": "uuid" },
                  "applicant": { "type": "object" },
                  "subject": { "type": "object" },
                  "declaration": { "type": "object" },
                  "documentExemptions": { "type": "object" },
                  "requestSummary": { "type": "string" },
                  "attachments": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/AttachmentInput" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hồ sơ trực tuyến đã được ghi nhận kèm mã hồ sơ và accessKey",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["case", "accessKey"],
                  "properties": {
                    "case": { "$ref": "#/components/schemas/CaseRecord" },
                    "accessKey": { "type": "string" }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Thiếu thành phần hồ sơ bắt buộc hoặc cơ quan không thuộc tuyến tiếp nhận",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/cases/counter": {
      "post": {
        "operationId": "createCounterCase",
        "tags": ["CaseWorkflow"],
        "summary": "Tiếp nhận hồ sơ trực tiếp tại quầy Một cửa (vai trò intake; đối chiếu bản chính và lập Mẫu 01)",
        "security": [
          { "staffCookieAuth": [], "csrfTokenAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "procedureCode",
                  "receivingAgency",
                  "applicantType",
                  "applicantName",
                  "citizenId",
                  "applicantPhone",
                  "applicantAddress",
                  "requestSummary",
                  "paperOriginals",
                  "identityVerified",
                  "submissionKey"
                ],
                "properties": {
                  "procedureCode": { "type": "string" },
                  "receivingAgency": { "type": "string" },
                  "applicantType": { "type": "string", "enum": ["citizen", "organization"] },
                  "applicantName": { "type": "string" },
                  "citizenId": { "type": "string" },
                  "applicantPhone": { "type": "string" },
                  "applicantEmail": { "type": "string" },
                  "applicantAddress": { "type": "string" },
                  "requestSummary": { "type": "string" },
                  "paperOriginals": { "type": "string" },
                  "identityVerified": { "type": "boolean" },
                  "submissionKey": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đã lập hồ sơ trực tiếp tại quầy ở trạng thái DA_TIEP_NHAN",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "403": {
            "description": "Chỉ cán bộ tiếp nhận thuộc cơ quan đó được lập hồ sơ tại quầy",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/cases/{code}": {
      "get": {
        "operationId": "getCaseDetail",
        "tags": ["CaseWorkflow"],
        "summary": "Xem chi tiết hồ sơ theo vai trò cán bộ và phạm vi cơ quan (chặn admin, ẩn PII với finance)",
