          }
        }
      }
    },
    "/api/cases/{code}/actions": {
      "post": {
        "operationId": "executeStaffCaseAction",
        "tags": ["CaseWorkflow"],
        "summary": "Thực hiện thao tác nghiệp vụ một cửa có kiểm soát đồng thời lạc quan expectedVersion",
        "description": "Hỗ trợ đầy đủ luồng nghiệp vụ: tiếp nhận Mẫu 01 (accept), hướng dẫn bổ sung Mẫu 02 (request_supplement), từ chối Mẫu 03 (reject_intake), phân công/hoàn trả (assign, return_to_intake, return_to_leader), số hóa tại quầy (digitize_documents), thẩm định chuyên môn (verify_original_register, assess_data_request, verify_published_procedure), lưu và trình dự thảo (save_draft, submit_review), phê duyệt/trả lại/từ chối giải quyết không bế tắc (approve, send_back, decline -> KHONG_GIAI_QUYET), gia hạn kèm phiếu xin lỗi Mẫu 04 (extend_deadline), cấu hình/miễn phí (set_fee, waive_fee), ký thử nghiệm Ed25519 (sign_result), phát hành sinh tệp kết quả điện tử (issue), trả kết quả (deliver) và xử lý dừng hồ sơ Mẫu 05/06 (prepare_stop_notice, issue_stop_notice, reject_stop_notice, confirm_paper_returned, close_expired_supplement).",
        "security": [
          { "staffCookieAuth": [], "csrfTokenAuth": [] }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/CaseCodeParam" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StaffCaseActionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hồ sơ đã cập nhật trạng thái và tăng version thêm 1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CaseRecord" }
              }
            }
          },
          "403": {
            "description": "Không đúng vai trò, cơ quan hoặc thiếu thẩm quyền ký được cấp riêng",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "Xung đột phiên bản expectedVersion (Optimistic Locking)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "422": {
            "description": "Vi phạm điều kiện tiên quyết của máy trạng thái hoặc dữ liệu biểu mẫu",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
