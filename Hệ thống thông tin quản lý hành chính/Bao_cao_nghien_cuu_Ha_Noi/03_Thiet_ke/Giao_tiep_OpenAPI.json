    "/api/cases/{code}/files/{stored}": {
      "get": {
        "operationId": "downloadCaseFile",
        "tags": ["CaseWorkflow"],
        "summary": "Tải tệp đính kèm, bản quét số hóa, văn bản Mẫu 05/06 hoặc kết quả điện tử của hồ sơ",
        "security": [
          { "staffCookieAuth": [] }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/CaseCodeParam" },
