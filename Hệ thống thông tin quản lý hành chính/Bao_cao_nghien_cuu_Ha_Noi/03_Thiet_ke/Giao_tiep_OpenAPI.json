          }
        }
      }
    },
    "/api/public/cases/{code}/actions": {
      "post": {
        "operationId": "executeCitizenCaseAction",
        "tags": ["CaseWorkflow"],
        "summary": "Thao tác trực tuyến của người nộp trên hồ sơ (bổ sung, gửi Mẫu 05 trực tuyến, nộp phí thử nghiệm, đánh giá)",
        "security": [
          { "citizenCookieAuth": [], "csrfTokenAuth": [] }
        ],
