{
  "openapi": "3.1.0",
  "info": {
    "title": "API Cốt lõi Cổng Dịch vụ công và Quy trình Hồ sơ Một cửa Hà Nội",
    "version": "2.0.0",
    "summary": "Đặc tả OpenAPI 3.1.0 đồng bộ 100% với hệ thống thực tế (/api/...)",
    "description": "Giao diện lập trình ứng dụng cốt lõi phục vụ tra cứu thủ tục công khai, không gian công dân số, nộp hồ sơ trực tuyến/tại quầy và xử lý quy trình một cửa (Mẫu 01-06, kiểm soát đồng thời lạc quan expectedVersion, kho khóa tra cứu Fernet và trả kết quả điện tử)."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8766",
      "description": "Máy chủ ứng dụng cục bộ (SQLite WAL)"
    }
  ],
  "tags": [
    {
      "name": "PublicCatalog",
      "description": "Tra cứu danh mục 2.075 thủ tục, lĩnh vực, cơ quan tiếp nhận, tin tức và kiểm tra nhanh trạng thái hồ sơ không lộ PII"
    },
    {
      "name": "CitizenAuthWorkspace",
      "description": "Xác thực công dân (bao gồm mô phỏng VNeID), hồ sơ cá nhân, bản nháp, thông báo và kho tài liệu điện tử"
    },
    {
      "name": "CaseWorkflow",
      "description": "Tiếp nhận, thẩm định, phê duyệt, gia hạn Mẫu 04, ký thử nghiệm Ed25519, phát hành điện tử và dừng hồ sơ Mẫu 05/06"
    }
  ],
  "components": {
    "securitySchemes": {
      "staffCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hni_session",
        "description": "Cookie phiên đăng nhập của cán bộ và quản trị viên (HttpOnly, SameSite=Strict, thời hạn 12 giờ)."
      },
      "citizenCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hni_citizen_session",
        "description": "Cookie phiên đăng nhập của công dân/tổ chức trên cổng dịch vụ công (HttpOnly, SameSite=Strict, thời hạn 12 giờ)."
      },
      "csrfTokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Mã chống giả mạo yêu cầu liên trang gắn với phiên hiện tại, bắt buộc trên các yêu cầu POST đã đăng nhập."
      }
    },
    "parameters": {
      "ProcedureCodeParam": {
        "name": "code",
        "in": "path",
        "required": true,
        "description": "Mã thủ tục hành chính quốc gia (ví dụ: 2.000908, 1.004237)",
        "schema": {
          "type": "string",
          "examples": ["2.000908", "1.004237"]
        }
      },
      "CaseCodeParam": {
        "name": "code",
        "in": "path",
        "required": true,
        "description": "Mã hồ sơ một cửa định dạng HN-YYYY-XXXXXXXX",
        "schema": {
          "type": "string",
          "examples": ["HN-2026-A1B2C3D4"]
        }
      },
      "StoredFileParam": {
        "name": "stored",
        "in": "path",
        "required": true,
        "description": "Tên tệp lưu trữ vật lý đã chuẩn hóa trong thư mục hồ sơ",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Thông báo lỗi tiếng Việt rõ nghĩa theo ngữ cảnh nghiệp vụ"
          }
        }
      },
      "AttachmentInput": {
        "type": "object",
        "required": ["name", "data"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "componentId": { "type": "string" },
          "data": {
            "type": "string",
            "description": "Nội dung tệp mã hóa Data URL hoặc Base64 (PNG, JPEG, PDF, TXT; tối đa 4 MB/tệp)"
          }
        }
      },
      "CaseStatus": {
        "type": "string",
        "enum": [
          "NHAP",
          "CHO_TIEP_NHAN",
          "CHO_BO_SUNG",
          "DA_TIEP_NHAN",
          "DANG_THU_LY",
          "TRINH_DUYET",
          "DA_PHE_DUYET",
          "DA_PHAT_HANH",
          "HOAN_THANH",
          "TU_CHOI",
          "KHONG_GIAI_QUYET",
          "DUNG"
        ]
      },
      "PublicStatusSummary": {
        "type": "object",
        "required": ["code", "procedureCode", "procedureName", "receivingAgency", "status", "statusLabel"],
        "properties": {
          "code": { "type": "string" },
          "procedureCode": { "type": "string" },
          "procedureName": { "type": "string" },
          "receivingAgency": { "type": "string" },
          "status": { "$ref": "#/components/schemas/CaseStatus" },
          "statusLabel": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "acceptedAt": { "type": ["string", "null"], "format": "date-time" },
          "deadline": { "type": ["string", "null"] },
          "updatedAt": { "type": "string", "format": "date-time" },
          "milestones": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "CaseRecord": {
        "type": "object",
        "required": ["code", "procedureCode", "status", "statusLabel", "version"],
        "properties": {
          "code": { "type": "string" },
          "procedureCode": { "type": "string" },
          "status": { "$ref": "#/components/schemas/CaseStatus" },
          "statusLabel": { "type": "string" },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Phiên bản kiểm soát đồng thời lạc quan (Optimistic Locking)"
          },
          "receivingAgency": { "type": "string" },
          "agencyScope": { "type": "string" },
          "submissionChannel": { "type": "string", "enum": ["ONLINE", "TRUC_TIEP"] },
          "applicantType": { "type": "string", "enum": ["citizen", "organization"] },
          "applicant": { "type": "object" },
          "declaration": { "type": "object" },
          "attachments": { "type": "array", "items": { "type": "object" } },
          "workflow": { "type": "object" },
          "workflowEvidence": { "type": ["object", "null"] },
          "assignment": { "type": ["object", "null"] },
          "supplement": { "type": ["object", "null"] },
          "deadline": { "type": ["string", "null"] },
          "deadlineExtension": { "type": ["object", "array", "null"] },
          "fee": { "type": "object" },
          "forms": {
            "type": "object",
            "description": "Dữ liệu in biểu mẫu một cửa Mẫu 01..06 kèm dữ liệu mã QR tra cứu",
            "properties": {
              "mau01": { "type": ["object", "null"] },
              "mau02": { "type": ["object", "null"] },
              "mau03": { "type": ["object", "null"] },
              "mau04": { "type": ["object", "null"] },
              "mau05": { "type": ["object", "null"] },
              "mau06": { "type": ["object", "null"] }
            }
          },
          "withdrawal": { "type": ["object", "null"] },
          "sandboxSignature": { "type": ["object", "null"] },
          "result": {
            "type": ["object", "null"],
            "properties": {
              "number": { "type": "string" },
              "content": { "type": "string" },
              "issuedAt": { "type": "string", "format": "date-time" },
              "signatureHash": { "type": "string" },
              "files": {
                "type": "array",
                "description": "Tệp kết quả điện tử sinh tự động khi phát hành, đồng bộ sang kho tài liệu công dân",
                "items": { "type": "object" }
              }
            }
          },
          "delivery": { "type": ["object", "null"] },
          "events": { "type": "array", "items": { "type": "object" } }
        }
      },
      "StaffCaseActionRequest": {
        "type": "object",
        "required": ["action", "expectedVersion"],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "request_supplement",
              "reject_intake",
              "assign",
              "return_to_intake",
              "digitize_documents",
              "set_fee",
              "waive_fee",
              "verify_original_register",
              "assess_data_request",
              "verify_published_procedure",
              "save_draft",
              "submit_review",
              "approve",
              "send_back",
              "decline",
              "extend_deadline",
              "sign_result",
              "return_to_leader",
              "issue",
              "deliver",
              "prepare_stop_notice",
              "issue_stop_notice",
              "reject_stop_notice",
              "confirm_paper_returned",
              "close_expired_supplement"
            ],
            "description": "Mã thao tác nghiệp vụ một cửa theo vai trò cán bộ"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "Phiên bản hiện tại của hồ sơ; trả 409 nếu hồ sơ vừa bị phiên khác cập nhật"
          },
          "payload": {
            "type": "object",
            "description": "Tham số chi tiết tương ứng với từng action (ví dụ: assignee, draft, reason, newDeadline, resultNumber, amount, basis, files...)"
          }
        }
      },
      "CitizenCaseActionRequest": {
        "type": "object",
        "required": ["action", "accessKey", "expectedVersion"],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "submit_supplement",
              "request_withdrawal",
              "create_payment",
              "confirm_payment",
              "feedback"
            ],
            "description": "Thao tác trực tuyến của chủ hồ sơ (bổ sung hồ sơ, gửi Mẫu 05 trực tuyến xin dừng/rút, thanh toán thử nghiệm, đánh giá hài lòng)"
          },
          "accessKey": {
            "type": "string",
            "description": "Khóa tra cứu 64 ký tự hex được cấp khi nộp hồ sơ"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["PublicCatalog"],
        "summary": "Kiểm tra trạng thái sẵn sàng của dịch vụ",
        "responses": {
          "200": {
            "description": "Máy chủ đang hoạt động",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/procedures": {
      "get": {
        "operationId": "listProcedures",
        "tags": ["PublicCatalog"],
        "summary": "Lấy danh mục 2.075 thủ tục hành chính",
        "parameters": [
          {
            "name": "summary",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["0", "1"] },
            "description": "Truyền summary=1 để nhận bản rút gọn phục vụ tải nhanh trên cổng"
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách thủ tục hành chính và tổng số bản ghi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["procedures", "count"],
                  "properties": {
                    "procedures": { "type": "array", "items": { "type": "object" } },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/procedures/{code}/detail": {
      "get": {
        "operationId": "getProcedureDetail",
        "tags": ["PublicCatalog"],
        "summary": "Xem chi tiết nội dung công bố, thành phần hồ sơ và điều kiện trực tuyến của thủ tục",
        "parameters": [
          { "$ref": "#/components/parameters/ProcedureCodeParam" }
        ],
        "responses": {
          "200": {
            "description": "Chi tiết thủ tục hành chính",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["procedure", "detail"],
                  "properties": {
                    "procedure": { "type": "object" },
                    "detail": { "type": "object" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy mã thủ tục",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/procedures/{code}/templates/{attachmentId}": {
      "get": {
        "operationId": "downloadProcedureTemplate",
        "tags": ["PublicCatalog"],
        "summary": "Tải biểu mẫu đơn, tờ khai công bố của thủ tục hành chính",
        "parameters": [
          { "$ref": "#/components/parameters/ProcedureCodeParam" },
          {
            "name": "attachmentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Luồng tệp biểu mẫu đính kèm"
          },
          "404": {
            "description": "Không tìm thấy mẫu đơn",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "Vượt ngưỡng giới hạn tải mẫu đơn",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "502": {
            "description": "Không tải được tệp nguồn từ Cổng Dịch vụ công quốc gia",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/procedure-categories": {
      "get": {
        "operationId": "listProcedureCategories",
        "tags": ["PublicCatalog"],
        "summary": "Lấy danh mục nhóm lĩnh vực thủ tục hành chính",
        "responses": {
          "200": {
            "description": "Danh sách nhóm lĩnh vực",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["categories"],
                  "properties": {
                    "categories": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/public/agencies": {
      "get": {
        "operationId": "listPublicAgencies",
        "tags": ["PublicCatalog"],
        "summary": "Danh sách cơ quan tiếp nhận đang hoạt động (Sở/ngành, Trung tâm PVHCC và 126 UBND xã/phường)",
        "responses": {
          "200": {
            "description": "Danh sách tên cơ quan tiếp nhận có bộ phận Một cửa hiệu lực",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["agencies"],
                  "properties": {
                    "agencies": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/public/news": {
      "get": {
        "operationId": "listPublicNews",
        "tags": ["PublicCatalog"],
        "summary": "Danh sách tin tức, thông báo hướng dẫn đã xuất bản trên cổng",
        "responses": {
          "200": {
            "description": "Danh sách bài viết công khai",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["articles"],
                  "properties": {
                    "articles": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/public/status-check": {
      "get": {
        "operationId": "checkPublicCaseStatusGet",
        "tags": ["PublicCatalog"],
        "summary": "Tra cứu nhanh trạng thái hồ sơ bằng mã hồ sơ (không cần đăng nhập, ẩn toàn bộ PII)",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Mã hồ sơ định dạng HN-YYYY-XXXXXXXX"
          }
        ],
        "responses": {
          "200": {
            "description": "Thông tin tiến độ tổng quát không chứa dữ liệu cá nhân",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicStatusSummary" }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy mã hồ sơ",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "post": {
        "operationId": "checkPublicCaseStatusPost",
        "tags": ["PublicCatalog"],
        "summary": "Tra cứu nhanh trạng thái hồ sơ qua thân JSON (không cần đăng nhập, ẩn toàn bộ PII)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "examples": ["HN-2026-A1B2C3D4"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thông tin tiến độ tổng quát không chứa dữ liệu cá nhân",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicStatusSummary" }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy mã hồ sơ",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/citizen/auth/register": {
      "post": {
        "operationId": "registerCitizen",
        "tags": ["CitizenAuthWorkspace"],
        "summary": "Đăng ký tài khoản công dân mới và khởi tạo phiên đăng nhập",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fullName", "email", "phone", "password"],
                "properties": {
                  "fullName": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "phone": { "type": "string" },
                  "password": { "type": "string", "minLength": 12 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công, cấp cookie hni_citizen_session và csrfToken",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "422": {
            "description": "Thông tin đăng ký không hợp lệ hoặc trùng email",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/citizen/auth/login": {
      "post": {
        "operationId": "loginCitizen",
        "tags": ["CitizenAuthWorkspace"],
        "summary": "Đăng nhập tài khoản công dân (hỗ trợ email/mật khẩu và mô phỏng định danh điện tử VNeID cục bộ)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "examples": ["congdan@example.test"] },
                  "password": { "type": "string" },
                  "provider": {
                    "type": "string",
                    "enum": ["PASSWORD", "VNEID_SANDBOX"],
                    "description": "Chế độ đăng nhập mật khẩu chuẩn hoặc mô phỏng VNeID mức 2 phục vụ thử nghiệm cục bộ"
                  },
                  "citizenId": { "type": "string", "description": "Số định danh cá nhân 12 số khi thử nghiệm luồng VNeID_SANDBOX" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công, thiết lập cookie hni_citizen_session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["user", "csrfToken"],
                  "properties": {
                    "user": { "type": "object" },
                    "csrfToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sai thông tin xác thực",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/citizen/auth/logout": {
      "post": {
        "operationId": "logoutCitizen",
        "tags": ["CitizenAuthWorkspace"],
        "summary": "Đăng xuất phiên công dân hiện tại",
        "security": [
          { "citizenCookieAuth": [], "csrfTokenAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Đã xóa phiên và thu hồi cookie hni_citizen_session",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/api/citizen/auth/me": {
      "get": {
        "operationId": "getCurrentCitizen",
        "tags": ["CitizenAuthWorkspace"],
        "summary": "Kiểm tra phiên đăng nhập công dân hiện hành và lấy csrfToken",
        "security": [
